# Azure AI endpoints (outputs of infra/main.bicep)
AZURE_OPENAI_ENDPOINT=https://<account>.openai.azure.com
AZURE_TRANSLATOR_ENDPOINT=https://<account>.cognitiveservices.azure.com
AZURE_TRANSLATOR_REGION=swedencentral

# Auth: set AZURE_AI_API_KEY for key auth (local testing).
# Leave it empty to use Microsoft Entra ID: managed identity (set AZURE_CLIENT_ID for a user-assigned identity)
# or your developer login (Az PowerShell / VS Code) via DefaultAzureCredential.
AZURE_AI_API_KEY=
AZURE_CLIENT_ID=
# Tenant of the AI resource, needed when your developer login defaults to another tenant
AZURE_TENANT_ID=
# Local container tests without keys: a token from
#   (Get-AzAccessToken -ResourceUrl https://cognitiveservices.azure.com -TenantId <tenant>).Token | ConvertFrom-SecureString -AsPlainText
# (expires after about an hour, never use in production)
AZURE_AI_ACCESS_TOKEN=

# Model deployments
MDT_TRANSLATE_DEPLOYMENT=translate
# MDT_REVIEW_DEPLOYMENT=translate
# MDT_ANALYSIS_DEPLOYMENT=translate
# MDT_TRANSLATE_REASONING=medium
# MDT_REVIEW_REASONING=high

# Feature switches (see README "Feature switches"; each can also be set per request)
# MDT_REVIEW=true
# MDT_NMT_FALLBACK=true
# MDT_PRESERVE_ANCHORS=true
# MDT_STRUCTURAL_CONTEXT=false
# MDT_CODE_COMMENTS=true
# MDT_DOCSTRINGS=true
# MDT_FRONT_MATTER=true
# MDT_MATH_SINGLE_DOLLAR=false

# API protection: clients must send this value in the x-api-key header
MDT_API_KEY=

# Optional segment translation memory on disk
# MDT_CACHE_DIR=.cache
# PORT=8080
